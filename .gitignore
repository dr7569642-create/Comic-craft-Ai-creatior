# ==========================================
# ComicCraft — Git Ignore Configuration
# ==========================================

# Environment variables & secrets (NEVER commit secrets!)
.env
.env.*
*.env
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Python virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.cache

# Generated media & storage (Preserve directory structure via .gitkeep)
backend/storage/panels/*
!backend/storage/panels/.gitkeep
backend/storage/exports/*
!backend/storage/exports/.gitkeep
storage/panels/*
!storage/panels/.gitkeep
storage/exports/*
!storage/exports/.gitkeep

# IDEs & Text Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & temporary files
*.log
*.tmp
*.bak
dist/
build/
*.egg-info/
*.zip
*.tar.gz
