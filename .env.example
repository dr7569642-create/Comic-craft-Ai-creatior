# Google Gemini API Key (Required for story & dialogue scripts)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
GEMINI_OUTLINE_MODEL=gemini-3.1-flash-lite
GEMINI_STORY_MODEL=gemini-3.1-flash-lite

# Image Generation Provider (No Hugging Face token required)
# Options: pollinations (Free, FLUX, no token) | imagen (Google GenAI) | procedural (Pillow comic art)
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=flux

# Server & Environment Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
