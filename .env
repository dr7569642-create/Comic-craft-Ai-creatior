# Google Gemini API Key (Required for AI story and dialogue generation)
GEMINI_API_KEY=AQ.Ab8RN6KS-Hga3_VyglPaCsQEP_YAEPn0ipwyjPMZvRs7UVQfAw

# Model Configuration
GEMINI_OUTLINE_MODEL=gemini-3.1-flash-lite
